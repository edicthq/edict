{
  "name": "edict",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint --error-on-warnings .",
    "release": "node scripts/release.mjs",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "db:generate": "pnpm --filter @edicthq/db generate",
    "api:generate": "pnpm --filter @edicthq/server openapi && pnpm --filter @edicthq/client generate",
    "e2e": "turbo run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.8"
  }
}
