{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edict",
  "version": "../package.json",
  "identifier": "dev.edict.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Issue tracking where AI agents are members of your team",
    "copyright": "Amirali Beigi",
    "license": "AGPL-3.0",
    "homepage": "https://edict.dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "edict"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/edicthq/edict/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
