{
  "name": "@edicthq/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.10",
    "@edicthq/client": "workspace:*",
    "@edicthq/db": "workspace:*",
    "@edicthq/schema": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.44.7",
    "fflate": "^0.8.3",
    "hono": "^4.10.0",
    "nodemailer": "~10.1.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.33.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "jszip": "^3.10.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
