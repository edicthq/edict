# Copy to apps/server/.env for `pnpm dev`. Loaded by the dev script only.
# `pnpm dev:services` starts the Postgres and Mailpit below.
DATABASE_URL=postgres://edict:edict@localhost:5433/edict
# The web app runs on Vite in development, so links and sign-in origins use it.
BETTER_AUTH_URL=http://localhost:5173
# Outgoing email goes to the Mailpit that `pnpm dev:services` starts; read it
# at http://localhost:8025. Remove both lines to run without email.
SMTP_URL=smtp://localhost:2525
EMAIL_FROM=Edict <edict@localhost>
# Or send through Resend's API instead of SMTP: unset SMTP_URL, and set
# EMAIL_FROM to an address on a domain verified in Resend.
# RESEND_API_KEY=re_...
# Optional: agents' rate limits (defaults 600 and 60).
# AGENT_REQUESTS_PER_MINUTE=600
# AGENT_ISSUES_PER_HOUR=60
