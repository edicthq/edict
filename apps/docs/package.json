    "lucide-react": "^1.50.0",
    "next": "16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
